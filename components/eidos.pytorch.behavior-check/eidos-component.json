{
  "release": "1.0.0",
  "kind": "artifact-op",
  "requires": [
    "artifact.reader/1",
    "artifact.writer/1",
    "pytorch.adapter/1"
  ],
  "optional": [],
  "card": "method-card.md",
  "python": ">=3.9",
  "dependencies": [
    "torch"
  ],
  "license": "Apache-2.0",
  "id": "eidos.pytorch.behavior-check",
