{
  "schema": "eidos-exp-rule/1",
  "id": "R-behav",
  "version": 1,
  "text": "T2 must be clean. T3 mean delta VRG must reach the pre-declared delta (default 0.15), with exact paired sign-flip p at most 0.10, or at most 0.06 at each look if one extension was declared. The shared vetoes also apply.",
  "keep_when": [
    {
      "check": "guardrails_clean",
      "equals": true,
      "tier": "T2"
    },
    {
      "metric": "vrg",
      "stat": "mean_delta",
      "op": ">=",
      "value": 0.15,
      "tier": "T3",
      "override": "delta"
    },
    {
      "metric": "vrg",
      "stat": "signflip_p",
      "op": "<=",
      "value": 0.1,
      "tier": "T3",
      "method": "exact_paired",
      "when": {
        "extension": false
      }
    },
    {
      "metric": "vrg",
      "stat": "signflip_p",
      "op": "<=",
      "value": 0.06,
      "tier": "T3",
      "method": "exact_paired",
      "each_look": true,
      "when": {
        "extension": true
      }
    }
  ],
  "overridable": {
    "delta": {
      "min": 0.1,
      "max": 0.5
    }
  },
  "inherits": [
    "VETOES"
  ]
}
