{
  "schema": "eidos-exp-rule/1",
  "id": "R-enable",
  "version": 1,
  "text": "Mean delta VRG must be at least -0.10, or autopilot delta VRG at least -0.01 when the plan declares model-free evaluation sufficient. The declared target metric must improve by the declared amount. The shared vetoes also apply.",
  "keep_when": [
    {
      "metric": "vrg",
      "stat": "mean_delta",
      "op": ">=",
      "value": -0.1,
      "tier": "planned",
      "when": {
        "model_free_suffices": false
      }
    },
    {
      "metric": "vrg",
      "stat": "mean_delta",
      "op": ">=",
      "value": -0.01,
      "tier": "T1",
      "mode": "autopilot",
      "when": {
        "model_free_suffices": true
      }
    },
    {
      "metric": "target",
      "stat": "improvement",
      "op": ">=",
      "value": {
        "plan": "target.amount"
      },
      "tier": "planned",
      "target_metric": {
        "plan": "target.metric"
      }
    }
  ]
}
